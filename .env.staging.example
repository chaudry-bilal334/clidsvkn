# =====================================================================
# STAGING ENVIRONMENT TEMPLATE — MySQL + Redis staging validation (G4)
# =====================================================================
# Copy to .env.staging and fill in real values before running
# scripts/mysql_staging_run.sh. Never commit the filled-in .env.staging
# file itself (.env.staging is gitignored; this .example is safe to
# commit).
#
# The staging script reads only the DB_*/REDIS_* keys from this file for
# its own pre-checks; the rest drive the app (migrations,
# clinic:backup/clinic:restore, alerting). Values not listed here fall
# back to config/ defaults — copy the full .env.example if you need
# finer control.
#
# Shell-environment overrides used by the staging run (NOT read from
# this file — export them before running to change the defaults):
#   TEST_DB=clinic_test_staging
#   RTO_PATIENTS=5000  RTO_APPOINTMENTS=30000  KEEP_EVIDENCE=1
#
# Keep values free of double/single quotes (the staging script strips
# them when parsing DB_*/REDIS_*).

APP_NAME=ClinicSuite
APP_ENV=staging
# REQUIRED for the staging run: generate with `php artisan key:generate`
# and keep it stable — clinic:backup/clinic:restore encrypt archives with
# APP_KEY-derived AES-256, and a rotating key orphans every backup.
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# --- MySQL (the staging run hard-requires DB_CONNECTION=mysql) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# App database: migrate:fresh --force runs here. It is not dropped — only
# the throwaway TEST_DB schema (clinic_test_staging) is created/dropped.
DB_DATABASE=clinic
DB_USERNAME=
DB_PASSWORD=

# --- Redis (realistic staging: sessions/cache/queue on Redis) ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# `null` (no quotes) = no password; set the real one if Redis requires auth.
REDIS_PASSWORD=null
SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
# Optional per-use DB indexes (defaults below match docker-compose.yml):
# REDIS_DB=0
# REDIS_CACHE_DB=1
# REDIS_QUEUE_DB=2
# The phpunit suite pins array/sync drivers (phpunit.xml), so Redis is
# exercised by the app-level smoke checks, not the suite.
BROADCAST_CONNECTION=log

# --- Backup archive disk (runbook §7 risk 1) ---
# 'local' is UNSAFE for production — archives die with the server (a dead
# app box = dead backups). For the staging timing run either disk works;
# point this at off-box storage (e.g. s3) before anything that matters.
BACKUP_DISK=local

# --- Backup-failure alerting (G12) ---
# E.164 phone that receives the SMS when clinic:backup fails; leave blank
# to fall back to the first Admin user's phone.
CLINIC_BACKUP_ALERT_SMS_TO=

# --- Messaging providers (optional — the staging run does not need them) ---
TWILIO_SMS_ENABLED=false
# =true once TWILIO_SID / TWILIO_AUTH_TOKEN / TWILIO_FROM are filled in
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WHATSAPP_CLOUD_API_ENABLED=false
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=v19.0
# Email rides on the MAIL_* mailer. Keep false until MAIL_MAILER is a real
# transport (never "log"/"array"); the driver refuses to report itself enabled
# against a non-delivering mailer so no message is falsely recorded as sent.
CLINIC_EMAIL_ENABLED=false

# --- JazzCash payment gateway (stays disabled until credentials are filled) ---
JAZZCASH_ENABLED=false
JAZZCASH_ENV=sandbox
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=