APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,::1,localhost:8000,localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:8000,http://localhost:5173,http://localhost:4173

BROADCAST_CONNECTION=log
REVERB_SCALING_ENABLED=false
FILESYSTEM_DISK=local

# Disk that `clinic:backup` archives live on. Keep this off-box (S3, etc.) in
# production so archives survive the application server (see DISASTER_RECOVERY_RUNBOOK).
BACKUP_DISK=local
# Phone number (E.164) that gets the SMS when `clinic:backup` fails. Leave
# blank to fall back to the first Admin user's phone.
CLINIC_BACKUP_ALERT_SMS_TO=
QUEUE_CONNECTION=database

# Clinical reference data readiness. Leave unset: enforcement then follows the
# app environment and is fail-closed in production, refusing prescriptions until
# allergens, dosage rules and drug interaction rules each have an approved row.
# Set to true to force enforcement on, or false only to exercise a non-production
# environment. This does NOT relax allergy/interaction/dosage blocking.
# CLINIC_REQUIRE_APPROVED_REFERENCE_DATA=

# External messaging providers (optional). Leave disabled to fall back to
# logged audit records in the notification_logs table.
TWILIO_SMS_ENABLED=false
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WHATSAPP_CLOUD_API_ENABLED=false
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=v19.0
# Email notifications ride on Laravel's MAIL_* mailer above. This flag only
# turns the email messaging driver on; it stays false until the clinic has both
# set it and pointed MAIL_MAILER at a transport that really delivers (a "log"
# or "array" mailer is treated as unconfigured, so nothing is reported as sent).
CLINIC_EMAIL_ENABLED=false

# JazzCash payment gateway (hosted checkout / mobile wallet, page redirection
# mode). Credentials come from the JazzCash merchant dashboard and are added to
# the real .env only — never committed. The gateway stays disabled (no outward
# calls) until JAZZCASH_ENABLED=true and the three credentials are filled in.
JAZZCASH_ENABLED=false
JAZZCASH_ENV=sandbox
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
# Optional overrides: where JazzCash posts the result, the gateway endpoints
# and where the browser lands afterwards (defaults are the sandbox/production
# merchantform URLs and this app's /billing screen).
# JAZZCASH_RETURN_URL=
# JAZZCASH_SANDBOX_URL=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform
# JAZZCASH_PRODUCTION_URL=https://payments.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform
# JAZZCASH_RETURN_REDIRECT_URL=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
